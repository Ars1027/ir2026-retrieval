{
  "method": "bm25-v1+vector",
  "chunks_dir": "artifacts/chunks",
  "bm25_index_dir": "artifacts/bm25",
  "vector_index_dir": "artifacts/vector/my-vector",
  "candidate_k": 200,
  "chunking": {
    "size": 1200,
    "overlap": 200,
    "min_chars": 120
  },
  "bm25": {
    "k1": 0.9,
    "b": 0.4,
    "use_stopwords": true,
    "capitalized_boost": 1.25
  },
  "vector": {
    "enabled": true,
    "retriever": "vector_backend.backend:create_retriever",
    "fusion": "vector_backend.backend:create_fusion",
    "top_k": 100,
    "model": "your-model-id",
    "promote": 3,
    "index_dir": "artifacts/vector/my-vector"
  },
  "retrieval": {
    "final_docs": 10,
    "evidence_docs": 5
  },
  "answer": {
    "mode": "extractive",
    "max_answer_chars": 200,
    "model": null,
    "base_url": null,
    "timeout_seconds": 30,
    "max_output_tokens": 200
  }
}
